# =============================================================================
# Database (Prisma + Supabase Postgres)
# =============================================================================
# Copy values from Supabase → Project Settings → Database.
# Use the DATABASE password (not the anon / publishable API key). URL-encode special characters in passwords.
#
# DATABASE_URL — pooled (Transaction pooler, port 6543) for runtime queries in serverless/edge.
# DIRECT_URL — non-pooled connection for `prisma migrate`, `db push`, introspection.
#
# Recommended (matches Supabase “Transaction pooler” + “Direct connection” in the UI):
#   DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#
# Example region host pattern: aws-1-ap-southeast-1.pooler.supabase.com (use the string from your dashboard).
#
# Alternate (if your dashboard only shows pooler URIs for both):
#   DATABASE_URL="postgresql://postgres.gnzxbldchgwtppprgnnk:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.gnzxbldchgwtppprgnnk:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
#
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Prisma CLI reads `.env` by default, not `.env.local`. Either duplicate DATABASE_URL + DIRECT_URL
# into a root `.env`, or use the npm scripts (they load `.env.local`):
#   npm run db:generate && npm run db:push

# =============================================================================
# Supabase (Auth)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
# Use either the legacy anon JWT or the new publishable key (not both required).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# In Supabase Dashboard → Authentication → URL configuration, set Site URL and add Redirect URLs, e.g.
#   http://localhost:3000/auth/callback
#   http://localhost:3000/oauth/consent
#   https://your-production-domain.com/auth/callback

# Server-only. Used for admin checks (e.g. /api/auth/check-email against Supabase Auth) — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Timeline AI (python-services/timeline_swarm). Requires OPENAI_API_KEY.
# LangGraph checkpoints use DIRECT_URL (not the pooled DATABASE_URL on port 6543).
# Optional override: TIMELINE_SWARM_DATABASE_URL=
