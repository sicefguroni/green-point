// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ============================================================================
// ACCOUNT-RELATED SCHEMAS
// ============================================================================

enum UserRole {
  ADMIN
  CITY_PLANNER
  RESIDENT
}

enum UserStatus {
  REGISTERED
  ACTIVE
  LOGGED_IN
  SUSPENDED
  DELETED
}

model User {
  id                String        @id @default(cuid())
  username          String        @unique
  email             String        @unique
  password          String
  role              UserRole      @default(RESIDENT)
  status            UserStatus    @default(REGISTERED)
  loginID           String?
  loginDate         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  administrator     Administrator?
  cityPlanner       CityPlanner?
  resident          Resident?
  systemLogs        SystemLog[]
  
  @@index([email])
  @@index([role])
  @@index([status])
}

/// App account data keyed by Supabase Auth user id (auth.users.id).
model Profile {
  id                       String   @id @default(cuid())
  supabaseUserId           String   @unique
  email                    String?

  firstName                String?
  lastName                 String?
  phone                    String?
  address                  String?

  hasCompletedOnboarding   Boolean  @default(false)

  avatarUrl                String?
  avatarStoragePath        String?

  idDocumentPath           String?
  idDocumentFileName       String?

  bio                      String?
  businessName             String?
  portfolioLinks           String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([supabaseUserId])
  @@index([hasCompletedOnboarding])
}

model Administrator {
  id                String        @id @default(cuid())
  adminID           String        @unique
  userID            String        @unique
  user              User          @relation(fields: [userID], references: [id], onDelete: Cascade)
  
  // Managed permissions
  managedUsers      String[]      // Array of user IDs
  managedDatasets   String[]      // Array of dataset IDs
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([userID])
}

model CityPlanner {
  id                String        @id @default(cuid())
  plannerID         String        @unique
  userID            String        @unique
  user              User          @relation(fields: [userID], references: [id], onDelete: Cascade)
  department        String?
  city              String?
  
  // Relations
  idVerification    IDVerification?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([userID])
  @@index([city])
}

model IDVerification {
  id                String        @id @default(cuid())
  verificationID    String        @unique
  plannerID         String        @unique
  planner           CityPlanner   @relation(fields: [plannerID], references: [id], onDelete: Cascade)
  
  // ID details
  idNumber          String
  idType            String        // e.g., "Government ID", "Professional License", "Employee ID"
  documentPath      String?       // Path to uploaded document file
  documentFileName  String?       // Original filename of uploaded document
  
  // Verification status
  status            String        @default("pending") // pending, approved, rejected
  verifiedBy        String?       // Admin user ID who verified
  verificationDate  DateTime?
  rejectionReason   String?
  
  submittedAt       DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([plannerID])
  @@index([status])
}

model Resident {
  id                String        @id @default(cuid())
  residentID        String        @unique
  userID            String        @unique
  user              User          @relation(fields: [userID], references: [id], onDelete: Cascade)
  address           String?
  city              String?
  barangay          String?
  
  // Relations
  geoPhotos         GeoPhoto[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([userID])
  @@index([city])
  @@index([barangay])
}

// ============================================================================
// DATA-RELATED SCHEMAS
// ============================================================================

model City {
  id                String        @id @default(cuid())
  cityID            String        @unique
  cityName          String
  province          String
  population        Int?
  area              Float?        // area in km²
  
  // Relations
  barangays         Barangay[]
  cityMetrics       CityMetrics?
  recommendations   GreeningRecommendation[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([cityName])
}

model CityMetrics {
  id                String        @id @default(cuid())
  cityID            String        @unique
  city              City          @relation(fields: [cityID], references: [id], onDelete: Cascade)
  
  averageGI         Float?
  populationDensity Float?
  averageTemperature Float?
  averageAQI        Float?
  
  lastUpdated       DateTime      @default(now())
  
  @@index([cityID])
}

model Barangay {
  id                String        @id @default(cuid())
  barangayID        String        @unique
  cityID            String
  city              City          @relation(fields: [cityID], references: [id], onDelete: Cascade)
  
  barangayName      String
  population        Int?
  area              Float?        // area in km²
  populationDensity Float?
  
  // Geographic data
  boundary          Json?         // GeoJSON boundary
  coordinates       Json?         // Centroid coordinates [lat, lng]
  
  // Relations
  points            Point[]
  metrics           BarangayMetrics?
  greeneryIndex     GreenerIndex?
  recommendations   GreeningRecommendation[]
  hazardExposures   HazardExposure[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([cityID])
  @@index([barangayName])
}

model BarangayMetrics {
  id                String        @id @default(cuid())
  barangayID        String        @unique
  barangay          Barangay      @relation(fields: [barangayID], references: [id], onDelete: Cascade)
  
  // Environmental metrics
  NDVI              Float?        // Normalized Difference Vegetation Index
  LST               Float?        // Land Surface Temperature
  treeCanopy        Float?        // Tree canopy coverage %
  greenArea         Float?        // Total green area km²
  airQuality        Float?        // Air Quality Index
  
  // Socioeconomic metrics
  povertyRate       Float?
  literacy          Float?
  healthAccess      Float?
  
  lastUpdated       DateTime      @default(now())
  
  @@index([barangayID])
}

model Point {
  id                String        @id @default(cuid())
  pointID           String        @unique
  barangayID        String
  barangay          Barangay      @relation(fields: [barangayID], references: [id], onDelete: Cascade)
  
  pointName         String
  infrastructure    String?       // Type: park, tree, building, etc.
  
  // Geographic data
  coordinates       Json          // {lat: number, lng: number}
  
  // Relations
  metrics           PointMetrics?
  recommendations   GreeningRecommendation[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([barangayID])
}

model PointMetrics {
  id                String        @id @default(cuid())
  pointID           String        @unique
  point             Point         @relation(fields: [pointID], references: [id], onDelete: Cascade)
  
  NDVI              Float?
  LST               Float?
  GI                Float?
  
  lastUpdated       DateTime      @default(now())
  
  @@index([pointID])
}

model GreenerIndex {
  id                String        @id @default(cuid())
  giID              String        @unique
  barangayID        String        @unique
  barangay          Barangay      @relation(fields: [barangayID], references: [id], onDelete: Cascade)
  
  // GI Components (0-1 scale)
  GI1_Quantity      Float         // Quantity of green space
  GI2_Equity        Float         // Equitable distribution
  GI3_Resilience    Float         // Resilience to climate
  GI4_Connectivity  Float         // Connectivity of spaces
  
  // Aggregate scores
  giValue           Float         // Overall GI value (0-100)
  giLevel           String        // Level: Low, Medium, High, Very High
  quantityScore     Float?
  equityScore       Float?
  resilienceScore   Float?
  connectivityScore Float?
  environmentalScore Float?
  accessibilityScore Float?
  
  // Weighting configuration
  weights           Json          // { gi1: 0.25, gi2: 0.25, gi3: 0.25, gi4: 0.25 }
  
  computeStatus     String        @default("pending") // pending, computing, computed
  lastUpdated       DateTime      @default(now())
  
  @@index([barangayID])
  @@index([giLevel])
}

model GreeningRecommendation {
  id                String        @id @default(cuid())
  recommendationID  String        @unique
  areaID            String?
  cityID            String?
  barangayID        String?
  pointID           String?
  
  // Relations (recommendation can be for city, barangay, or point)
  city              City?         @relation(fields: [cityID], references: [id], onDelete: SetNull)
  barangay          Barangay?     @relation(fields: [barangayID], references: [id], onDelete: SetNull)
  point             Point?        @relation(fields: [pointID], references: [id], onDelete: SetNull)
  
  // Recommendation details
  source            String        // e.g., "AI Engine", "User Suggestion"
  name              String
  description       String
  interventionType  String        // e.g., pocket park, street trees, rooftop garden
  relevancy         Float         // 0-1 score
  efficiency        Float?        // Implementation efficiency
  equipmentNeeded   String?
  
  // Cost and equity
  cost              Float?        // Estimated cost
  costUnit          String?       // "PHP", "USD", etc.
  costEstimate      Json?
  costEstimateUpdatedAt DateTime?
  equity            Float?        // Equity impact 0-1
  
  // Priority and status
  priority          String        @default("medium") // low, medium, high
  status            String        @default("proposed") // proposed, approved, rejected, implemented, archived
  
  // Implementation
  hasBudget         Boolean       @default(false)
  implementationOptions Json?
  monitoringMetrics Json?
  
  // Approval workflow
  approvedBy        String?
  approvalDate      DateTime?
  rejectionReason   String?
  recordedOutcome   String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([cityID])
  @@index([barangayID])
  @@index([pointID])
  @@index([status])
  @@index([priority])
}

model MetricData {
  id                String        @id @default(cuid())
  metricID          String        @unique
  
  metricType        String        // NDVI, LST, AQI, etc.
  metricValue       Float
  metricUnit        String        // %, ppm, °C, etc.
  
  // Source info
  source            String        // API, Manual, Satellite, etc.
  dataSet           String?       // Foreign key to Dataset
  
  // Temporal info
  dateRecorded      DateTime      @default(now())
  validFrom         DateTime?
  validTo           DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([metricType])
  @@index([dateRecorded])
}

model MapLayer {
  id                String        @id @default(cuid())
  mapID             String        @unique
  
  mapType           String        // hazard, greenery, temperature, etc.
  mapName           String
  mapLink           String?       // Mapbox or API endpoint
  
  // Visual properties
  toggleVisibility  Boolean       @default(true)
  color             String?       // Hex color or color name
  opacity           Float         @default(1.0)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([mapType])
}

model Dataset {
  id                String        @id @default(cuid())
  dataSetID         String        @unique
  
  dataSetName       String
  dataType          String        // environmental, socioeconomic, hazard, etc.
  lastUpdated       DateTime      @default(now())
  dataSource        String        // API name, file source, etc.
  
  // Dataset metadata
  recordCount       Int?
  validationStatus  String        @default("pending") // pending, valid, invalid
  
  createdAt         DateTime      @default(now())
  
  @@index([dataType])
}

model GeoPhoto {
  id                String        @id @default(cuid())
  photoID           String        @unique
  residentID        String
  resident          Resident      @relation(fields: [residentID], references: [id], onDelete: Cascade)
  
  // Photo metadata
  imagePath         String
  imageFile         String        // filename
  location          Json          // {lat: number, lng: number}
  barangayID        String?
  
  description       String?
  tags              String[]
  
  uploadDate        DateTime      @default(now())
  uploader          String
  
  createdAt         DateTime      @default(now())
  
  @@index([residentID])
  @@index([uploadDate])
}

model HazardExposure {
  id                String        @id @default(cuid())
  barangayID        String
  barangay          Barangay      @relation(fields: [barangayID], references: [id], onDelete: Cascade)
  
  hazardType        String        // flood, storm, heatwave, landslide, etc.
  exposureLevel     Int?          // 0-5 scale
  exposureScore     Float?        // 0-1 scale
  affectedPopulation Int?
  
  lastUpdated       DateTime      @default(now())
  
  @@unique([barangayID, hazardType])
  @@index([barangayID])
  @@index([hazardType])
}

// ============================================================================
// LOGGING & AUDIT SCHEMAS
// ============================================================================

model SystemLog {
  id                String        @id @default(cuid())
  userID            String?
  user              User?         @relation(fields: [userID], references: [id], onDelete: SetNull)
  
  action            String        // login, logout, data_upload, etc.
  resource          String?       // entity type affected
  resourceID        String?       // specific entity ID
  
  status            String        // success, failure
  details           Json?
  
  timestamp         DateTime      @default(now())
  
  @@index([userID])
  @@index([action])
  @@index([timestamp])
}

model ResearchStudy {
  id          String   @id @default(cuid())
  title       String
  author      String?
  year        Int?
  url         String?
  summary     String?  @db.Text
  filePath    String?  
  
  chunks      StudyChunk[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
}

model StudyChunk {
  id              String        @id @default(cuid())
  studyID         String
  study           ResearchStudy @relation(fields: [studyID], references: [id], onDelete: Cascade)
  
  content         String        @db.Text
  embedding       Unsupported("vector(1536)")?
  
  chunkIndex      Int
  
  createdAt       DateTime      @default(now())

  @@index([studyID])
}

// ============================================================================
// LANGGRAPH CHECKPOINT SCHEMAS
// ============================================================================

model CheckpointMigration {
  v Int @id

  @@map("checkpoint_migrations")
}

model Checkpoint {
  threadId           String
  checkpointNs       String   @default("")
  checkpointId       String
  parentCheckpointId String?
  type               String?
  checkpoint         Json
  metadata           Json     @default("{}")

  @@id([threadId, checkpointNs, checkpointId])
  @@index([threadId], map: "checkpoints_thread_id_idx")
  @@map("checkpoints")
}

model CheckpointBlob {
  threadId     String
  checkpointNs String @default("")
  channel      String
  version      String
  type         String
  blob         Bytes?

  @@id([threadId, checkpointNs, channel, version])
  @@index([threadId], map: "checkpoint_blobs_thread_id_idx")
  @@map("checkpoint_blobs")
}

model CheckpointWrite {
  threadId     String
  checkpointNs String @default("")
  checkpointId String
  taskId       String
  taskPath     String @default("")
  idx          Int
  channel      String
  type         String?
  blob         Bytes

  @@id([threadId, checkpointNs, checkpointId, taskId, idx])
  @@index([threadId], map: "checkpoint_writes_thread_id_idx")
  @@map("checkpoint_writes")
}
