{
  "name": "green-point",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:validate": "dotenv -e .env.local -- prisma validate",
    "data:pipeline:warm": "node scripts/data-pipeline-warm.mjs",
    "timeline:swarm:install": "cd python-services/timeline_swarm && py -m pip install -r requirements.txt",
    "timeline:swarm": "cd python-services/timeline_swarm && py -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --reload"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/earthengine": "^1.7.21",
    "@mapbox/search-js-react": "^1.5.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    
    "@turf/turf": "^7.2.0",
    "@types/pg": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "uuid": "^11.1.0",
    "exifr": "^7.1.3",
    "html2canvas-pro": "^2.0.2",
    "jsondiffpatch": "^0.7.6",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "mapbox-gl": "^3.15.0",
    "next": "^15.5.12",
    "openai": "^6.36.0",
    "pg": "^8.20.0",
    "react": "19.1.0",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.2.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "swagger-ui-react": "^5.32.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "pdf-parse": "^2.4.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.15",
    "globals": "^17.4.0",
    "lodash": "^4.17.23",
    "prisma": "^7.6.0",
    "supabase": "^2.76.14",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
